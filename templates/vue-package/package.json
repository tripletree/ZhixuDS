{
  "name": "@zhixu/fabricmind-ui",
  "version": "0.1.0",
  "description": "知序 FabricMind design system — Vue 3 component library (dark/light themes, Tailwind CSS 4 tokens)",
  "keywords": [
    "vue",
    "components",
    "design-system",
    "fabricmind",
    "zhixu"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tripletree/ZhixuDS.git",
    "directory": "templates/vue-package"
  },
  "homepage": "https://github.com/tripletree/ZhixuDS/tree/main/templates/vue-package#readme",
  "publishConfig": {
    "access": "restricted"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "verify:package": "npm run build:lib && node scripts/verify-package.mjs && vue-tsc -p tests/tsconfig.consumer.json && npm pack --dry-run",
    "prepublishOnly": "npm run verify:package"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "echarts": "^5.6.0",
    "lucide-vue-next": "^0.469.0",
    "motion-dom": "12.5.0",
    "motion-utils": "12.5.0",
    "motion-v": "^0.13.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.0.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "files": [
    "dist-lib",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./style.css": "./dist-lib/style.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "echarts": "^5.5.0",
    "motion-v": "^0.13.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  }
}
